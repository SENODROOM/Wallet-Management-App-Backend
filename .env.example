# MongoDB connection string.
# Local example: mongodb://127.0.0.1:27017/wallet_notepad
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wallet_notepad
MONGODB_URI=mongodb://127.0.0.1:27017/wallet_notepad

# Port the Express server listens on
PORT=5000

# Secret used to sign login sessions (JWT). Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
